generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COACH
  PLAYER
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
}

enum TraitCategory {
  STRENGTH
  WEAKNESS
}

enum DominantHand {
  LEFT
  RIGHT
}

enum PointStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum OccurrenceStatus {
  PLANNED
  CANCELLED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

// ---------- Clubs (multi-tenant) ----------

// Chaque club est un "tenant" : toutes ses données (saisons, comptes, joueurs,
// entraineurs, sparrings, exercices, et tout ce qui en découle) lui sont
// rattachées via clubId sur les entités racines. L'isolation est appliquée
// automatiquement par le client Prisma scopé (src/lib/tenant.js).
model Club {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  // Licence annuelle : le club a accès jusqu'à licenseEndsAt (+ délai de grâce,
  // voir src/lib/license.js). Vide = aucune licence (accès refusé). Renseignée
  // par le paiement Stripe (webhook) ou manuellement (npm run club -- license).
  licenseEndsAt        DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?

  seasons   Season[]
  users     User[]
  players   Player[]
  coaches   Coach[]
  sparrings Sparring[]
  exercises Exercise[]
}

// ---------- Saisons & utilisateurs ----------

model Season {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerSeasons    PlayerSeason[]
  rankingHistories RankingHistory[]
  trainingGroups   TrainingGroup[]
  trainings        Training[]
  trainingPlans    TrainingPlan[]
  camps            Camp[]

  @@index([clubId])
}

model User {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  roles        Role[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  players UserPlayer[]

  coachId String? @unique
  coach   Coach?  @relation(fields: [coachId], references: [id])

  @@index([clubId])
}

// Association many-to-many : un compte (ex. parent) peut voir la fiche de
// plusieurs joueurs (ex. ses enfants), utile quand une famille partage un
// seul email pour plusieurs inscriptions.
model UserPlayer {
  id       String @id @default(cuid())
  userId   String
  playerId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId])
}

// ---------- Joueurs ----------

model Player {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  birthDate     DateTime
  licenseNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Coordonnées et signalétique complémentaires.
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  photoUrl              String? // data URL (base64)
  playStyle             String?
  dominantHand          DominantHand?

  users             UserPlayer[]
  playerSeasons     PlayerSeason[]
  rankingHistories  RankingHistory[]
  evaluations       Evaluation[]
  equipment         Equipment[]
  traits            PlayerTrait[]
  pointsToWork      PointToWork[]
  evolutionNotes    EvolutionNote[]
  media             PlayerMedia[]
  groupAssignments  PlayerGroupAssignment[]
  attendances       Attendance[]
  campEnrollments   CampPeriodGroupPlayer[]
  campAttendances   CampAttendance[]
  sparringProfile   Sparring?
  campRegistrations CampPlayer[]

  @@index([clubId])
}

model PlayerSeason {
  id       String       @id @default(cuid())
  playerId String
  seasonId String
  status   PlayerStatus @default(ACTIVE)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId])
}

model RankingHistory {
  id            String   @id @default(cuid())
  playerId      String
  seasonId      String
  rankingValue  String
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([playerId, seasonId])
}

// Évaluation sportive périodique (0-10 par critère) : chaque entrée est un
// instantané daté, jamais modifié après coup, pour constituer un historique
// exploitable (radar de la dernière évaluation, courbes d'évolution).
model Evaluation {
  id           String   @id @default(cuid())
  playerId     String
  coachId      String?
  date         DateTime @default(now())
  service      Int
  remise       Int
  coupDroit    Int
  revers       Int
  deplacements Int
  tactique     Int
  mental       Int
  physique     Int
  note         String?
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  coach  Coach? @relation(fields: [coachId], references: [id])

  @@index([playerId])
}

model Equipment {
  id            String    @id @default(cuid())
  playerId      String
  type          String
  brand         String?
  model         String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model PlayerTrait {
  id            String        @id @default(cuid())
  playerId      String
  category      TraitCategory
  description   String
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime      @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model PointToWork {
  id          String      @id @default(cuid())
  playerId    String
  description String
  status      PointStatus @default(OPEN)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdBy Coach? @relation(fields: [createdById], references: [id])

  @@index([playerId])
}

model EvolutionNote {
  id        String   @id @default(cuid())
  playerId  String
  coachId   String?
  date      DateTime @default(now())
  note      String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  coach  Coach? @relation(fields: [coachId], references: [id])

  @@index([playerId])
}

model PlayerMedia {
  id        String    @id @default(cuid())
  playerId  String
  type      MediaType
  url       String
  createdAt DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ---------- Groupes & entrainements ----------

model TrainingGroup {
  id              String   @id @default(cuid())
  seasonId        String
  name            String
  rankingCriteria String?
  createdAt       DateTime @default(now())

  season            Season                  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerAssignments PlayerGroupAssignment[]
  trainings         Training[]
}

model PlayerGroupAssignment {
  id        String    @id @default(cuid())
  playerId  String
  groupId   String
  startDate DateTime  @default(now())
  endDate   DateTime?

  player Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  group  TrainingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([groupId])
}

model Coach {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  user                User?
  trainingOccurrences TrainingOccurrenceCoach[]
  trainingPlans       TrainingPlan[]
  exercisesCreated    Exercise[]
  pointsToWork        PointToWork[]
  evolutionNotes      EvolutionNote[]
  evaluations         Evaluation[]
  campPeriodGroups    CampPeriodGroupCoach[]
  trainings           TrainingCoach[]
  campGroups          CampGroupCoach[]

  @@unique([clubId, email])
  @@index([clubId])
}

model Sparring {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  ranking      String?
  isClubMember Boolean  @default(false)
  playerId     String?  @unique
  externalClub String?
  createdAt    DateTime @default(now())

  player              Player?                   @relation(fields: [playerId], references: [id])
  trainingOccurrences TrainingOccurrenceCoach[]
  campPeriodGroups    CampPeriodGroupCoach[]
  trainings           TrainingCoach[]
  campGroups          CampGroupCoach[]

  @@index([clubId])
}

model Training {
  id        String   @id @default(cuid())
  seasonId  String
  groupId   String
  name      String
  location  String?
  weekday   Int? // 0=lundi ... 6=dimanche
  startTime String? // "18:00"
  endTime   String?
  createdAt DateTime @default(now())

  season      Season               @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  group       TrainingGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  occurrences TrainingOccurrence[]
  coaches     TrainingCoach[]
}

// Encadrants (entraineurs / sparrings) affectés par défaut à l'entrainement :
// copiés sur chaque séance générée, modifiable ensuite au cas par cas sur la
// séance via TrainingOccurrenceCoach.
model TrainingCoach {
  id         String  @id @default(cuid())
  trainingId String
  coachId    String?
  sparringId String?

  training Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  coach    Coach?    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sparring Sparring? @relation(fields: [sparringId], references: [id], onDelete: Cascade)
}

model TrainingOccurrence {
  id         String           @id @default(cuid())
  trainingId String
  date       DateTime
  startTime  String
  endTime    String
  status     OccurrenceStatus @default(PLANNED)

  training    Training                  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  coaches     TrainingOccurrenceCoach[]
  attendances Attendance[]
}

model TrainingOccurrenceCoach {
  id           String  @id @default(cuid())
  occurrenceId String
  coachId      String?
  sparringId   String?

  occurrence TrainingOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  coach      Coach?             @relation(fields: [coachId], references: [id])
  sparring   Sparring?          @relation(fields: [sparringId], references: [id])
}

model Attendance {
  id           String           @id @default(cuid())
  occurrenceId String
  playerId     String
  status       AttendanceStatus @default(ABSENT)
  note         String?

  occurrence TrainingOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  player     Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, playerId])
}

// ---------- Plans d'entrainement & exercices ----------

model TrainingPlan {
  id          String    @id @default(cuid())
  seasonId    String
  coachId     String?
  title       String
  description String?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  season     Season                 @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  coach      Coach?                 @relation(fields: [coachId], references: [id])
  exercises  TrainingPlanExercise[]
  campGroups CampGroup[]
}

enum ExerciseCategory {
  Regularite
  Topspin
  Service
  Remise
  Bloc
  Deplacements
  PanierDeBalles
  Poussette
  Tactique
  Defense
  ContreInitiative
  Physique
  Mental
  Jeunes
}

enum ExerciseDifficulty {
  NIVEAU_1
  NIVEAU_2
  NIVEAU_3
  NIVEAU_4
  NIVEAU_5
}

model Exercise {
  id          String              @id @default(cuid())
  clubId      String
  club        Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    ExerciseCategory?
  difficulty  ExerciseDifficulty?
  diagram     Json? // schéma table de ping-pong : { points: [{ id, x, y }] }
  createdById String?
  createdAt   DateTime            @default(now())

  // Fiche pédagogique enrichie (bibliothèque d'exercices standard).
  intensity          Int? // 1 à 5
  skills             Json? // string[] — qualités travaillées (ex. "Regularite", "Pivot")
  objective          String?
  instructions       Json? // string[] — consignes
  successCriteria    Json? // string[] — critères de réussite
  easierVariant      Json? // string[]
  harderVariant      Json? // string[]
  competitionVariant Json? // string[]
  sourceCode         String? // référence dans la bibliothèque source (ex. "REG-001"), pour import idempotent

  createdBy Coach?                 @relation(fields: [createdById], references: [id])
  plans     TrainingPlanExercise[]

  @@unique([clubId, sourceCode])
  @@index([clubId])
}

model TrainingPlanExercise {
  id             String @id @default(cuid())
  trainingPlanId String
  exerciseId     String

  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([trainingPlanId, exerciseId])
}

// ---------- Stages ----------

model Camp {
  id        String   @id @default(cuid())
  seasonId  String
  name      String
  location  String?
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  season  Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  days    CampDay[]
  groups  CampGroup[]
  players CampPlayer[]
}

// Joueurs inscrits au stage (liste de référence des présences). Chaque période,
// les entraineurs répartissent ces joueurs dans les groupes (CampPeriodGroupPlayer).
model CampPlayer {
  id       String @id @default(cuid())
  campId   String
  playerId String

  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([campId, playerId])
}

model CampDay {
  id     String   @id @default(cuid())
  campId String
  date   DateTime

  camp    Camp         @relation(fields: [campId], references: [id], onDelete: Cascade)
  periods CampPeriod[]
}

model CampPeriod {
  id        String @id @default(cuid())
  campDayId String
  label     String // "Matinée", "Après-midi", ...
  startTime String
  endTime   String

  campDay     CampDay           @relation(fields: [campDayId], references: [id], onDelete: Cascade)
  groups      CampPeriodGroup[]
  attendances CampAttendance[]
}

model CampGroup {
  id             String  @id @default(cuid())
  campId         String
  name           String // "Initiation", "Perfectionnement", "Psychomotricité", ...
  trainingPlanId String?

  camp         Camp              @relation(fields: [campId], references: [id], onDelete: Cascade)
  trainingPlan TrainingPlan?     @relation(fields: [trainingPlanId], references: [id])
  periods      CampPeriodGroup[]
  coaches      CampGroupCoach[]
}

// Encadrants par défaut d'un groupe de stage : copiés sur chaque CampPeriodGroup
// créé (quand le groupe est affecté à une période), modifiables ensuite au cas
// par cas sur cette période via CampPeriodGroupCoach.
model CampGroupCoach {
  id          String  @id @default(cuid())
  campGroupId String
  coachId     String?
  sparringId  String?

  campGroup CampGroup @relation(fields: [campGroupId], references: [id], onDelete: Cascade)
  coach     Coach?    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sparring  Sparring? @relation(fields: [sparringId], references: [id], onDelete: Cascade)
}

model CampPeriodGroup {
  id           String @id @default(cuid())
  campPeriodId String
  campGroupId  String

  period  CampPeriod              @relation(fields: [campPeriodId], references: [id], onDelete: Cascade)
  group   CampGroup               @relation(fields: [campGroupId], references: [id], onDelete: Cascade)
  coaches CampPeriodGroupCoach[]
  players CampPeriodGroupPlayer[]

  @@unique([campPeriodId, campGroupId])
}

model CampPeriodGroupCoach {
  id                String  @id @default(cuid())
  campPeriodGroupId String
  coachId           String?
  sparringId        String?

  campPeriodGroup CampPeriodGroup @relation(fields: [campPeriodGroupId], references: [id], onDelete: Cascade)
  coach           Coach?          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sparring        Sparring?       @relation(fields: [sparringId], references: [id], onDelete: Cascade)
}

model CampPeriodGroupPlayer {
  id                String @id @default(cuid())
  campPeriodGroupId String
  playerId          String

  campPeriodGroup CampPeriodGroup @relation(fields: [campPeriodGroupId], references: [id], onDelete: Cascade)
  player          Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([campPeriodGroupId, playerId])
}

// Présence d'un joueur inscrit sur une période (indépendante de son groupe).
model CampAttendance {
  id           String           @id @default(cuid())
  campPeriodId String
  playerId     String
  status       AttendanceStatus @default(ABSENT)

  campPeriod CampPeriod @relation(fields: [campPeriodId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([campPeriodId, playerId])
}
