DATABASE_URL="postgresql://user:password@localhost:5432/ping_club_manager"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
RESEND_API_KEY="re_xxx"
RESEND_FROM="onboarding@resend.dev"
# Création de club en libre-service (/signup) : désactivée par défaut.
ALLOW_CLUB_SIGNUP="false"
# Licences : paiement en ligne (Stripe), optionnel. Sans ces clés, seule
# l'activation manuelle (npm run club -- license) fonctionne.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# Génération d'exercices/plans par IA (aistudio.google.com/apikey — gratuit,
# aucune carte bancaire requise, 500 requêtes/jour). Optionnel : sans clé, les
# boutons "Générer avec l'IA" renvoient une erreur explicite.
GEMINI_API_KEY=""
