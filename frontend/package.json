{
  "name": "ping-club-manager-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "npx -y @vite-pwa/assets-generator@1",
    "build:mobile": "vite build --mode capacitor && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "icons:mobile": "cp public/logo.svg assets/logo.svg && npx -y @capacitor/assets@3 generate --ios --android --iconBackgroundColor '#0284c7' --iconBackgroundColorDark '#0284c7' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#0f172a'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@vueup/vue-quill": "^1.5.5",
    "axios": "^1.7.7",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.15",
    "pinia": "^2.2.2",
    "primeicons": "^8.0.1",
    "primevue": "^3.53.1",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^5.1.2",
