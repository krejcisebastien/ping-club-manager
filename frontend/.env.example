VITE_API_URL=http://localhost:4000/api

# Personnalisation par club (optionnel) — voir DEPLOYMENT.md pour déployer
# une nouvelle instance pour un autre club.
# VITE_CLUB_NAME=Club Tennis de Table
# VITE_CLUB_ICON=pi-star-fill

# Notifications push web (PWA) — optionnel. Projet Firebase identique à
# FIREBASE_SERVICE_ACCOUNT (API). Console Firebase > Paramètres du projet :
# « Vos applications » (app web) et Cloud Messaging > « Certificats Web Push ».
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
